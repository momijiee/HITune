   5          #include <reg52.h>
   6          #define uchar unsigned char
   7          #define uint  unsigned int
   8          //DS1302引脚定义,可根据实际情况自行修改端口定义
   9          sbit RST=P1^3;
  10          sbit IO=P1^2;
  11          sbit SCK=P1^1;
  12          //DS1302地址定义
  13          #define ds1302_sec_add                  0x80            //秒数据地址
  14          #define ds1302_min_add                  0x82            //分数据地址
  15          #define ds1302_hr_add                   0x84            //时数据地址
  16          #define ds1302_date_add                 0x86            //日数据地址
  17          #define ds1302_month_add                0x88            //月数据地址
  18          #define ds1302_day_add                  0x8a            //星期数据地址
  19          #define ds1302_year_add                 0x8c            //年数据地址
  20          #define ds1302_control_add              0x8e            //控制数据地址
  21          #define ds1302_charger_add              0x90                                     
  22          #define ds1302_clkburst_add             0xbe
  23          //初始时间定义
  24          uchar time_buf[8] = {0x20,0x10,0x09,0x14,0x23,0x59,0x50,0x02};//初始时间
  25          uchar readtime[14];//当前时间
  26          uchar sec_buf=0;  //秒缓存
  27          uchar sec_flag=0; //秒标志位
  28          //功能:延时1毫秒
  29          //入口参数:x
  30          //出口参数:无
  31          //说明:晶振为12M
  32          void Delay_xms(uint x)
  33          {
  34   1        uint i,j;
  35   1        for(i=0;i<x;i++)
  36   1          for(j=0;j<112;j++);
  37   1      }
  38          //DS1302初始化函数
  39          void ds1302_init(void) 
  40          {
  41   1              RST=0;                  //RST脚置低
  42   1              SCK=0;                  //SCK脚置低
  43   1      }
  44          //向DS1302写入一字节数据
  45          void ds1302_write_byte(uchar addr, uchar d) 
  46          {
  47   1              uchar i;
  48   1              RST=1;                                  //启动DS1302总线        
  49   1              //写入目标地址：addr
  50   1              addr = addr & 0xFE;   //最低位置零，寄存器0位为0时写，为1时读
  51   1              for (i = 0; i < 8; i ++) {
  52   2                      if (addr & 0x01) {
  53   3                              IO=1;
  54   3                              }
  55   2                      else {
C51 COMPILER V9.60.7.0   MAIN                                                              12/21/2024 15:16:33 PAGE 2   

  56   3                              IO=0;
  57   3                              }
  58   2                      SCK=1;      //产生时钟
  59   2                      SCK=0;
  60   2                      addr = addr >> 1;
  61   2                      }       
  62   1              //写入数据：d
  63   1              for (i = 0; i < 8; i ++) {
  64   2                      if (d & 0x01) {
  65   3                              IO=1;
  66   3                              }
  67   2                      else {
  68   3                              IO=0;
  69   3                              }
  70   2                      SCK=1;    //产生时钟
  71   2                      SCK=0;
  72   2                      d = d >> 1;
  73   2                      }
  74   1              RST=0;          //停止DS1302总线
  75   1      }
  76          
  77          //从DS1302读出一字节数据
  78          uchar ds1302_read_byte(uchar addr) {
  79   1      
  80   1              uchar i,temp;   
  81   1              RST=1;                                  //启动DS1302总线
  82   1              //写入目标地址：addr
  83   1              addr = addr | 0x01;    //最低位置高，寄存器0位为0时写，为1时读
  84   1              for (i = 0; i < 8; i ++) {
  85   2                      if (addr & 0x01) {
  86   3                              IO=1;
  87   3                              }
  88   2                      else {
  89   3                              IO=0;
  90   3                              }
  91   2                      SCK=1;
  92   2                      SCK=0;
  93   2                      addr = addr >> 1;
  94   2                      }       
  95   1              //输出数据：temp
  96   1              for (i = 0; i < 8; i ++) {
  97   2                      temp = temp >> 1;
  98   2                      if (IO) {
  99   3                              temp |= 0x80;
 100   3                              }
 101   2                      else {
 102   3                              temp &= 0x7F;
 103   3                              }
 104   2                      SCK=1;
 105   2                      SCK=0;
 106   2                      }       
 107   1              RST=0;                                  //停止DS1302总线
 108   1              return temp;
 109   1      }
 110          //向DS302写入时钟数据
 111          void ds1302_write_time(void) 
 112          {
 113   1              ds1302_write_byte(ds1302_control_add,0x00);                     //关闭写保护 
 114   1              ds1302_write_byte(ds1302_sec_add,0x80);                         //暂停时钟 
 115   1              //ds1302_write_byte(ds1302_charger_add,0xa9);       //涓流充电 
 116   1              ds1302_write_byte(ds1302_year_add,time_buf[1]);         //年 
 117   1              ds1302_write_byte(ds1302_month_add,time_buf[2]);        //月 
C51 COMPILER V9.60.7.0   MAIN                                                              12/21/2024 15:16:33 PAGE 3   

 118   1              ds1302_write_byte(ds1302_date_add,time_buf[3]);         //日 
 119   1              ds1302_write_byte(ds1302_hr_add,time_buf[4]);           //时 
 120   1              ds1302_write_byte(ds1302_min_add,time_buf[5]);          //分
 121   1              ds1302_write_byte(ds1302_sec_add,time_buf[6]);          //秒
 122   1              ds1302_write_byte(ds1302_day_add,time_buf[7]);          //周 
 123   1              ds1302_write_byte(ds1302_control_add,0x80);                     //打开写保护     
 124   1      }
 125          //从DS302读出时钟数据
 126          void ds1302_read_time(void)  
 127          {
 128   1              time_buf[1]=ds1302_read_byte(ds1302_year_add);          //年 
 129   1              time_buf[2]=ds1302_read_byte(ds1302_month_add);         //月 
 130   1              time_buf[3]=ds1302_read_byte(ds1302_date_add);          //日 
 131   1              time_buf[4]=ds1302_read_byte(ds1302_hr_add);            //时 
 132   1              time_buf[5]=ds1302_read_byte(ds1302_min_add);           //分 
 133   1              time_buf[6]=(ds1302_read_byte(ds1302_sec_add))&0x7f;//秒，屏蔽秒的第7位，避免超出59
 134   1              time_buf[7]=ds1302_read_byte(ds1302_day_add);           //周    
 135   1      }
 136          //串口初始化(系统晶振为12MHz)
 137          void Uart_init(uchar Baud_flag)
 138          {
 139   1         TMOD = 0x20;       //T1 2
 140   1         PCON = 0x00;       //SMOD = 0
 141   1         SCON = 0x50;       //串口1 8
 142   1         switch(Baud_flag)
 143   1         {    
 144   2          case 0x00:        //2400 11.0592M:0xf4
 145   2                TH1=0xf3;
 146   2                TL1=0xf3;
 147   2              break;
 148   2              case 0x01:        //4800 11.0592M:0xfa
 149   2                TH1=0xf9;
 150   2                TL1=0xf9;
 151   2              break;
 152   2          case 0x02:        //9600 11.0592M:0xfd
 153   2                TH1=0xfd;
 154   2                TL1=0xfd;
 155   2              break;
 156   2          case 0x03:        //19200 11.0592M:0xfe
 157   2            TH1=0xfd;
 158   2                TL1=0xfd;
 159   2          break;
 160   2              default:          //默认为2400
 161   2                TH1=0xf3;
 162   2                TL1=0xf3;
 163   2              break;
 164   2         }
 165   1         TR1 = 1;               //启动定时器1                                                         
 166   1         ES=1;              //开串口中断
 167   1         EA=1;              //开总中断       
 168   1      }
 169          //串口发送
 170          void Send_char(uchar ch)
 171          {
 172   1       SBUF=ch; 
 173   1       while(!TI);      //等待发送完毕
 174   1       TI=0;           //清中断
 175   1      }
 176          //主函数
 177          void main(void)
 178          { 
 179   1       Delay_xms(50);//等待系统稳定
