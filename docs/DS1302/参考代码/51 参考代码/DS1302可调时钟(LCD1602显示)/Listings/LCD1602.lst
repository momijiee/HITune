 115          // 在特定位置，显示一个有符号数字(-32768 ~ 32767)
 116          void LCD_ShowSignedNub(unsigned char Rows, unsigned char Cols, int Nub, unsigned char Len)
 117          {
 118   1              unsigned char i;
 119   1              Set_Position(Rows, Cols);
 120   1              if (Nub >= 0)
 121   1              {
 122   2                      LCD1602_WriteData('+');
 123   2                      for (i = Len; i > 0; i--)
 124   2                      {
 125   3                              LCD1602_WriteData(((Nub / SetNub(10, i) % 10) + 0x30)); // 加上0x30是将数字转换成字符。例�
             -��数字0的十六进制ASCLL码为0x00，但是字符0的十六进制ASCLL码为0x30，所以直接加0x30就可以完�
             -��转换了。
 126   3                      }
 127   2              }
 128   1              else
 129   1              {
 130   2                      LCD1602_WriteData('-');
 131   2                      for (i = Len; i > 0; i--)
 132   2                      {
 133   3                              LCD1602_WriteData(((-(Nub) / SetNub(10, i) % 10) + 0x30)); // 加上0x30是将数字转换成字符。�
             -��如数字0的十六进制ASCLL码为0x00，但是字符0的十六进制ASCLL码为0x30，所以直接加0x30就可以�
             -��成转换了。
 134   3                      }
 135   2              }
 136   1      }
