 138          // 在特定位置，显示一个十六进制数 (0 ~ 0xFFFF)
 139          void LCD_ShowHex(unsigned char Rows, unsigned char Cols, unsigned int Hex, unsigned char Len)
 140          {
 141   1              unsigned char i, HexNub;
 142   1              Set_Position(Rows, Cols);
 143   1              
 144   1              for (i = Len; i > 0; i--)
 145   1              {
 146   2                      HexNub = (Hex / SetNub(16, i)) % 16;
 147   2                      if (HexNub < 10)  LCD1602_WriteData(HexNub + 0x30);  
 148   2                      else LCD1602_WriteData(HexNub + 55);
 149   2              }
 150   1                      
 151   1      }
 152          
 153          // 在特定位置，显示一个二进制数(0 ~ 1111 1111 1111 1111)
 154          void LCD_ShowBin(unsigned char Rows, unsigned char Cols, unsigned int Bin, unsigned char Len)
 155          {
 156   1              unsigned char i, BinNub;
 157   1              Set_Position(Rows, Cols);
 158   1              
 159   1              for (i = Len; i > 0; i--)
 160   1              {
 161   2                      BinNub = (Bin / SetNub(2, i)) % 2;
 162   2                      LCD1602_WriteData(BinNub + 0x30);
 163   2              }
 164   1                      
 165   1      }


