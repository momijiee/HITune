  55          // 用于设置位置，在哪里显示。
  56          void Set_Position(unsigned char Row, unsigned char Col)
  57          {
  58   1              if (Row == 1)
  59   1              {
  60   2                      LCD1602_WriteCmd(0x80 | (Col - 1));  // 映射的位置的数据最高位固定为1，所以真实的地
             -址应该要再或上0x80
  61   2              }
  62   1              else
  63   1              {
  64   2                      LCD1602_WriteCmd((0x80 | (Col - 1)) + 0x40);
  65   2              }
  66   1      }
  67          
  68          // 在特定位置，显示 单个字节
  69          void LCD_ShowChar(unsigned char Rows, unsigned char Cols, unsigned char Char)
  70          {
  71   1              Set_Position(Rows, Cols);
  72   1              LCD1602_WriteData(Char);
  73   1              
  74   1      }
  75          
  76          // 在特定位置，显示 一个字符串
  77          void LCD_ShowString(unsigned char Rows, unsigned char Cols, unsigned char String[])
  78          {
  79   1              unsigned char i;
  80   1              Set_Position(Rows, Cols);
  81   1              for (i = 0; String[i] != '\0'; i++)
  82   1              {
  83   2                      LCD1602_WriteData(String[i]);
  84   2              }
  85   1      }
  86          
  87          
  88          
  89          //123 / 100 % 10  = 1
  90          //123 / 10  % 10  = 2
  91          //123 / 1   % 10  = 3
  92          // 用于计算某个数字的次方结果 
  93          unsigned int SetNub(unsigned char Nub, Len)
  94          {
  95   1              unsigned int NubValue = 1;
  96   1              unsigned char i;
  97   1              for (i = 0; i < (Len - 1); i++)
  98   1              {
  99   2                      NubValue *= Nub;
 100   2              }
 101   1              return NubValue;
 102   1      }
 103          
 104          // 在特定位置，显示一个有符号数字(0 ~ 65535)
 105          void LCD_ShowNub(unsigned char Rows, unsigned char Cols, unsigned int Nub, unsigned char Len)
 106          {
 107   1              unsigned char i;
 108   1              Set_Position(Rows, Cols);
 109   1              for (i = Len; i > 0; i--)
 110   1              {
 111   2                      LCD1602_WriteData(((Nub / SetNub(10, i) % 10) + 0x30)); // 加上0x30是将数字转换成字符。例�
             -�数字0的十六进制ASCLL码为0x00，但是字符0的十六进制ASCLL码为0x30，所以直接加0x30就可以完�
             -�转换了。
 112   2              }
 113   1      }
