  13          sbit DS1302_SCLK = P1^0;
  14          char TimeData[] = {23, 07, 05, 11, 13, 7, 5};  // 年 月 日 时 分 秒 周
  15          
  16          void DS1302_Write(unsigned char Cmd, Time)
  17          {
  18   1              unsigned char i;
  19   1              DS1302_CE = 0;
  20   1              DS1302_SCLK = 0;
  21   1              
  22   1              DS1302_CE = 1;
  23   1              for (i = 0; i < 8; i++)
  24   1              {
  25   2                      
  26   2                      DS1302_DATA = Cmd & (0x01 << i);
  27   2                      DS1302_SCLK = 1;
  28   2                      DS1302_SCLK = 0;
  29   2                      
  30   2              }
  31   1              
  32   1              for (i = 0; i < 8; i++)
  33   1              {
  34   2                      
  35   2                      DS1302_DATA = Time & (0x01 << i);
  36   2                      DS1302_SCLK = 1;
  37   2                      DS1302_SCLK = 0;
  38   2                      
  39   2              }
  40   1              DS1302_CE = 0;
  41   1      }
  42          
  43          unsigned char DS1302_Read(unsigned char Adderss)
  44          {
  45   1              unsigned char Data = 0x00, i;
  46   1              Adderss |= 0x01;
  47   1              DS1302_CE = 0;
  48   1              DS1302_SCLK = 0;
  49   1              
  50   1              DS1302_CE = 1;
  51   1              for (i = 0; i < 8; i++)
  52   1              {
  53   2                      DS1302_SCLK = 0;
  54   2                      DS1302_DATA = Adderss & (0x01 << i);
C51 COMPILER V9.60.7.0   DS1302                                                            07/10/2024 09:34:39 PAGE 2   

  55   2                      DS1302_SCLK = 1;
  56   2              }
  57   1              
  58   1              for (i = 0; i < 8; i++)
  59   1              {
  60   2                      DS1302_SCLK = 1;
  61   2                      DS1302_SCLK = 0;
  62   2                      if (DS1302_DATA)
  63   2                      {
  64   3                              Data |= (0x01 << i);
  65   3                      }
  66   2              }
  67   1              
  68   1              DS1302_CE = 0;
  69   1              DS1302_DATA = 0;
  70   1              Data = ((Data / 16 * 10) + (Data % 16));
  71   1              return Data;
  72   1      }
  73          
  74          void Set_DS1302Time()
  75          {
  76   1              DS1302_Write(WP, 0x00);
  77   1              DS1302_Write(YearAdd,  (TimeData[0] / 10 * 16) + (TimeData[0] % 10));
  78   1              DS1302_Write(MonthAdd, (TimeData[1] / 10 * 16) + (TimeData[1] % 10));
  79   1              DS1302_Write(DataAdd,  (TimeData[2] / 10 * 16) + (TimeData[2] % 10));
  80   1              DS1302_Write(HourAdd,  (TimeData[3] / 10 * 16) + (TimeData[3] % 10));
  81   1              DS1302_Write(MinAdd,   (TimeData[4] / 10 * 16) + (TimeData[4] % 10));
  82   1              DS1302_Write(SecAdd,   (TimeData[5] / 10 * 16) + (TimeData[5] % 10));
  83   1              DS1302_Write(WeekAdd,  (TimeData[6] / 10 * 16) + (TimeData[6] % 10));
  84   1              DS1302_Write(WP, 0x80);
  85   1      }
  86          
  87          void Read_DS1302Time()
  88          {
  89   1      
  90   1              TimeData[0] = DS1302_Read(YearAdd);
  91   1              TimeData[1] = DS1302_Read(MonthAdd);
  92   1              TimeData[2] = DS1302_Read(DataAdd);
  93   1              TimeData[3] = DS1302_Read(HourAdd);
  94   1              TimeData[4] = DS1302_Read(MinAdd);
  95   1              TimeData[5] = DS1302_Read(SecAdd);
  96   1              TimeData[6] = DS1302_Read(WeekAdd);
  97   1      }


