   1          #include <REGX52.H>
   2          #define   SecAdd     0x80
   3          #define   MinAdd     0x82
   4          #define   HourAdd    0x84
   5          #define   DataAdd    0x86
   6          #define   MonthAdd   0x88
   7          #define   YearAdd    0x8C
   8          #define   WeekAdd    0x8A
   9          #define   WP         0x8E
  10          
  11          sbit DS1302_CE = P1^2;
